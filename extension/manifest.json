{
  "manifest_version": 3,
  "name": "ShareGuard",
  "version": "0.8.0",
  "minimum_chrome_version": "116",
  "description": "Create a protected audience view of a browser tab with selective redaction and manual blackouts.",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ShareGuard: protect this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*",
        "file:///*"
      ],
      "js": [
        "detector.js",
        "scanner.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
